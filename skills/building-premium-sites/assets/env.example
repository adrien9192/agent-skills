# .env.example - every variable this pack uses, in one place.
# Copy to .env.local in the client project, fill it in, and confirm .env* is gitignored.

# ── Site (required) ───────────────────────────────────────────────────────────
SITE_URL=https://example.com                    # canonical origin (sitemap, JSON-LD, emails)
NEXT_PUBLIC_SITE_URL=https://example.com        # same value, exposed to the client (audit bot UA)
NEXT_PUBLIC_SITE_NAME=Client                  # short brand name (audit bot UA, UI fallbacks)
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com   # publicly displayed email

# ── Brevo transactional email (required when there is a form) ─────────────────
# Get it from app.brevo.com > SMTP & API. Configure SPF/DKIM/DMARC on the sending
# domain BEFORE going live, or the form lands in spam (QA-CHECKLIST section H).
BREVO_API_KEY=                                # API v3 (preferred)
BREVO_SENDER_EMAIL=no-reply@example.com         # sender authenticated with Brevo
BREVO_SENDER_NAME=Client
BREVO_TO_EMAIL=contact@example.com              # recipient of the leads
# SMTP variant (when the API is unavailable):
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# ── Search engines (optional) ─────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=         # Search Console verification meta tag
NEXT_PUBLIC_BING_VERIFICATION=

# ── Lead-gen audit tool (optional — BLUEPRINT §9 ter module) ──────────────────
AUDIT_ADMIN_TOKEN=                            # Bearer token of the admin routes (long, random)
AUDIT_BOT_UA=                                 # crawler UA; defaults to NEXT_PUBLIC_SITE_NAME/_URL
SUPABASE_URL=                                 # lead storage (PostgREST direct, no SDK)
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=                            # optional public AI narrative - without a key, deterministic scoring only

# -- Local QA script (scripts/audit-local.mjs: the script reads these, not the app) --
# AUDIT_BASE_URL=http://localhost:3000
# AUDIT_BRAND=Client
# AUDIT_CANONICAL_ORIGIN=https://example.com
# AUDIT_PAGES=/,/contact                      # absent = auto-discovery via sitemap.xml
# AUDIT_MENU_SELECTOR=header button           # 'skip' to skip this check
# AUDIT_API_PAGES=/api/contact                # '' = none
